{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build:vercel",
  "outputDirectory": ".vercel/output",
  "regions": ["sin1"],
  "headers": [
    { "source": "/api/(.*)", "headers": [
      { "key": "Cache-Control", "value": "private, no-store" },
      { "key": "X-Content-Type-Options", "value": "nosniff" }
    ] }
  ]
}
