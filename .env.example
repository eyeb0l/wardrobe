OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_QUALITY=high

# Optional saved-outfit discovery and owned-item swaps. Server-only; off by default.
WARDROBE_DECISIONS_ENABLED=0
OPENAI_DECISIONS_MODEL=gpt-6-luna
# Shopping: individual-photo comparisons for up to three shortlisted pieces.
# Requires WARDROBE_DECISIONS_ENABLED=1; advisory and off by default.
WARDROBE_DECISIONS_SHOPPING_OVERLAP_ENABLED=0
# Candidate outfit checks: Preview only, with WARDROBE_PREVIEW_ENABLED=1.
# Crop checks and other environments retain version 1.
WARDROBE_DECISIONS_OUTFIT_RUBRIC_VERSION=1

# Add a PNG at data/model-reference.png or point to another local file.
WARDROBE_MODEL_REFERENCE=data/model-reference.png

# Hosted production only. Vercel provisions DATABASE_URL and BLOB_READ_WRITE_TOKEN.
# Enable after configuring Vercel Authentication > All Deployments.
# WARDROBE_HOSTED_ENABLED=1
# WARDROBE_DAILY_IMAGE_API_LIMIT=40
# WARDROBE_DAILY_TEXT_API_LIMIT=1000
# Legacy WARDROBE_DAILY_API_LIMIT is an image-only fallback.
# CRON_SECRET=generate-a-random-secret-for-production-storage-cleanup
